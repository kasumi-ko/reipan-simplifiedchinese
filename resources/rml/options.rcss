/*
 * The options screen.  theme.rcss carries the palette and the shared pieces;
 * this is the layout: the game's window centred on the PS2's 640x448, the
 * jade band with the title along its top, the sections under it, the rows
 * between two rules, help and prompts below.  The rows are the game's
 * option lists: pale names, sage values, the cursor the menus' cream sheen.
 */

/* Light: the game draws its own backdrop under this screen (pause.c runs the
 * option screens' menu backdrop, snow and fog and all; the title stays up
 * behind it). */
.backdrop.light
{
    background-color: #070a0d40;
    decorator: image(images/vignette.png);
}

#frame
{
    position: absolute;
    left: 50%;
    top: 22dp;
    bottom: 18dp;
    width: 540dp;
    margin-left: -270dp;
    /* A fade rather than theme.rcss's rise: a transform on an ancestor makes
     * RmlUi clip the scrolling rows with a mask, which the backend does not
     * draw, so they would spill out of #pages until it settled. */
    animation: 0.2s quadratic-out fade-in;
}

/* The window, a little wider than the column it holds, and see-through
 * enough that the backdrop's snow still falls behind the rows. */
#panel
{
    position: absolute;
    left: -14dp;
    right: -14dp;
    top: 0;
    bottom: -4dp;
    background-color: #020406a8;
}

#header
{
    position: absolute;
    left: -11dp;
    right: -11dp;
    top: 0;
}

#header .title
{
    font-size: 22dp;
    line-height: 30dp;
    white-space: nowrap;
}

/* ---- sections ---------------------------------------------------------- */

#tabs
{
    position: absolute;
    left: 0;
    right: 0;
    top: 38dp;
    height: 20dp;
    white-space: nowrap;
}

.tab
{
    display: inline-block;
    padding: 0 9dp;
    height: 18dp;
    line-height: 18dp;
    font-size: 13dp;
    font-style: italic;
    letter-spacing: 0.5dp;
    color: #8d9780;
    border-bottom: 2dp #00000000;
    cursor: pointer;
}

.tab:hover
{
    color: #e4e6dc;
}

.tab.active
{
    color: #f6f2e2;
    border-bottom-color: #d8ccb0;
    font-effect: glow(0dp 3dp 0dp 0dp #2f8a7066);
}

#rule-top
{
    position: absolute;
    left: -10dp;
    right: -10dp;
    top: 60dp;
}

/* ---- rows -------------------------------------------------------------- */

#pages
{
    position: absolute;
    left: 0;
    right: 0;
    top: 70dp;
    bottom: 66dp;
    overflow-y: auto;
}

.page
{
    padding-right: 8dp;
}

/* The game's own list headings ("Functions", "Sound"): pale italic. */
.heading
{
    margin: 10dp 0 3dp 0;
    padding: 0 0 1dp 2dp;
    font-size: 12dp;
    font-style: italic;
    letter-spacing: 0.5dp;
    color: #9fc8b8;
    border-bottom: 1dp #2a3d48;
}

.row
{
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 19dp;
    line-height: 19dp;
    cursor: pointer;
}

.row-label
{
    font-size: 13dp;
}

.row-value
{
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 220dp;
    font-size: 12dp;
    color: #a9b2a0;
}

.row.selected .row-value
{
    color: #f6f2e2;
}

.row.disabled .row-value
{
    color: #4e5a58;
}

.value
{
    display: inline-block;
    min-width: 54dp;
    text-align: center;
    white-space: nowrap;
}

.choice .value
{
    width: 168dp;
}

.slider .value
{
    width: 58dp;
    text-align: right;
    padding-right: 4dp;
}

/* A button: a steel well, the game's option slots, in an ink frame. */
.action-value
{
    padding: 0 12dp;
    border: 1dp #3d5058;
    background-color: #13202a;
    line-height: 15dp;
    font-size: 11dp;
    letter-spacing: 1dp;
}

.row.selected .action-value
{
    border-color: #d8ccb0;
    background-color: #2f4650;
}

.row.disabled .action-value
{
    border-color: #1c272d;
    background-color: #0b1116;
}

/* The step arrows: dim at rest, lit on the cursor's row. */
.arrow
{
    display: inline-block;
    width: 14dp;
    text-align: center;
    font-size: 15dp;
    color: #3d5058;
}

.row.selected .arrow
{
    color: #d8ccb0;
}

.row.disabled .arrow,
.row.disabled.selected .arrow
{
    color: #1c272d;
}

.arrow:hover
{
    color: #f6f2e2;
}

/* A slider: a steel well with the fill inside it, cream on the cursor's
 * row. */
.track
{
    display: inline-block;
    position: relative;
    width: 120dp;
    height: 5dp;
    margin: 0 4dp;
    background-color: #0b1116;
    border: 1dp #3d5058;
}

.fill
{
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: #5f7378;
}

.row.selected .fill
{
    background-color: #d8ccb0;
}

.row.disabled .fill
{
    background-color: #1c272d;
}

/* ---- help and prompts ------------------------------------------------- */

#rule-bottom
{
    position: absolute;
    left: -10dp;
    right: -10dp;
    bottom: 56dp;
}

#help
{
    position: absolute;
    left: 4dp;
    right: 4dp;
    bottom: 20dp;
    height: 32dp;
    font-size: 11.5dp;
    font-style: italic;
    word-break: break-word;
    color: #8d9780;
}

#prompts
{
    position: absolute;
    right: 0;
    bottom: 2dp;
    height: 14dp;
}
